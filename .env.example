# Frontend environment (Vite exposes only VITE_* variables to the browser).
VITE_API_URL=http://localhost:8000
# Supabase: project URL and the *publishable* key (sb_publishable_...), both safe for the browser.
# Leave blank to run without accounts (watchlist stays in localStorage).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
