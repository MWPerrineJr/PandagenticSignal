# Copy to .env and adjust. All variables are prefixed STOCK_API_.
STOCK_API_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional regex for hosts with per-deploy subdomains (Lovable preview + published sites)
STOCK_API_CORS_ORIGIN_REGEX=
# Rate limiting (slowapi syntax) and logging
STOCK_API_RATE_LIMIT=120/minute
STOCK_API_RATE_LIMIT_ENABLED=true
STOCK_API_LOG_FORMAT=text
STOCK_API_LOG_LEVEL=INFO
